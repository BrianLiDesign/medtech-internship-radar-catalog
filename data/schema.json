{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Internship row",
  "description": "One internship posting or program-fallback row in the MedTech Internship Radar Catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "company",
    "title",
    "apply_url",
    "season",
    "role_family",
    "location",
    "degree",
    "row_kind",
    "source",
    "first_seen",
    "last_seen"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUID v5 from scripts/internship_ids.py",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "apply_url": {
      "type": "string",
      "minLength": 1,
      "description": "Direct apply or internship-program URL. Rows without this URL are omitted from the README."
    },
    "season": {
      "type": "string",
      "description": "Internship season. v1 default is summer-2027; later summers are allowed.",
      "pattern": "^summer-[0-9]{4}$"
    },
    "role_family": {
      "type": "string",
      "enum": [
        "Software",
        "BME/R&D",
        "Electrical/firmware",
        "Mechanical/robotics",
        "Data/ML",
        "Quality/manufacturing",
        "Other STEM"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "US city/state list, or Remote (US). Join sites with '; ' when one apply URL covers many cities."
    },
    "degree": {
      "type": "string",
      "enum": ["bs", "ms", "bs_ms", "unspecified"]
    },
    "row_kind": {
      "type": "string",
      "enum": ["posting", "program_fallback"]
    },
    "source": {
      "type": "string",
      "enum": ["scrape", "seed", "issue"]
    },
    "first_seen": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "last_seen": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "req_id": {
      "type": "string",
      "minLength": 1
    },
    "posted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "work_auth": {
      "type": "string",
      "enum": ["citizen_only", "us_auth_no_sponsor", "unspecified"]
    },
    "eligibility": {
      "type": "string",
      "enum": ["open", "returning"]
    },
    "closed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "close_reason": {
      "type": "string",
      "minLength": 1
    },
    "miss_count": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_apply_url": {
      "type": "string",
      "minLength": 1
    },
    "program_url": {
      "type": "string",
      "minLength": 1
    },
    "ats": {
      "type": "string",
      "minLength": 1
    },
    "short_description": {
      "type": "string"
    }
  }
}
